# Copy to .env (never commit .env).
POSTGRES_DB=forma
POSTGRES_USER=forma
POSTGRES_PASSWORD=forma_dev

# Integrations — fill locally, keep out of the repo.
HEVY_API_KEY=
# Garmin password is asked interactively by `ingest garmin-login`; only tokens are stored (volume garmin_tokens).
GARMIN_EMAIL=
# Fitatu password is asked by `ingest fitatu-login`; only the session is stored (volume fitatu_session).
FITATU_EMAIL=

# Claude (coach chat): `claude setup-token` -> CLAUDE_CODE_OAUTH_TOKEN; ANTHROPIC_API_KEY takes precedence when set.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
COACH_MODEL=claude-opus-5-5
COACH_EFFORT=medium
# Forma MCP server (services/mcp, not built yet)
FORMA_MCP_URL=
FORMA_MCP_TOKEN=
